# Server-side secret only. Never prefix with NEXT_PUBLIC_ and never commit a real key.
MODEL_API_KEY=
# Paid Meta calls stay off unless this is exactly "true" (protects hackathon credits on preview deploys).
META_CALLS_ENABLED=false
# Direct Meta Model API adapter default. Confirm access for your account before deployment.
META_MODEL_ID=muse-spark-1.3
# Optional: only set when intentionally switching to a compatible endpoint.
# META_BASE_URL=https://api.meta.ai/v1

# WhatsApp Cloud API (see docs/WHATSAPP_SETUP.md). Server-side only.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated phone numbers allowed to trigger intake (recommended).
WHATSAPP_ALLOWED_SENDERS=
# Replies are composed and traced but only sent when this is exactly "true".
WHATSAPP_REPLIES_ENABLED=false
# WHATSAPP_GRAPH_VERSION=v22.0

# Firebase / Firestore (optional in local demo; required for durable webhook state).
# Create a service account in Firebase/Google Cloud and paste these server-only values in Vercel.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the escaped newlines exactly as provided by the service-account JSON.
FIREBASE_PRIVATE_KEY=

# Firebase web app (public config from Firebase console → Project settings → Your apps → Web app,
# or `npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID>`). Not secrets; used by /team sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Team members allowed into /team (comma-separated). Their email must also be verified in Firebase Auth.
GRINFLOW_TEAM_EMAILS=
# Optional shared fallback for /team and scripts.
OPERATOR_KEY=
